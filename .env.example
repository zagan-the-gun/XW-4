# コピーして .env にリネームして使う（.env は Git に入れない）
RTSP_USER=admin
RTSP_PASS=change_me   # カメラの初期パスワードは変更しておく
CAMERA_IP=192.168.11.27

# タイムゾーン
TZ=Asia/Tokyo

# --- 実行環境の切り替え ---
# N100（Intel iGPU, amd64）: 以下 3 行を有効化
#FRIGATE_TAG=stable
#COMPOSE_FILE=docker-compose.yml:docker-compose.n100.yml
#CONFIG_FILE=/config/config.yml

# Apple Silicon Mac（GPU なし・CPU 検出器）: 以下 2 行を有効化
#FRIGATE_TAG=stable-standard-arm64
#CONFIG_FILE=/config/config.mac.yml

# WSL など amd64 で GPU なし: FRIGATE_TAG=stable と CONFIG_FILE=/config/config.mac.yml

# 危険度アラート（Discord Webhook。空なら通知しない）
DISCORD_WEBHOOK_URL=
# 通知に載せる統計ページの URL（例 http://192.168.11.13:8080/）
DASHBOARD_URL=
# 通知する最低レベル low / medium / high
ALERT_MIN_LEVEL=medium
